# Copy this file to .env.local for local development, and set the same
# values in your Vercel project's Environment Variables for production.

# --- GitHub content commits (production only) ---
# Not needed locally -- local admin edits write straight to disk. On Vercel,
# saving in /admin commits the change to this repo via GitHub's API, which
# then triggers a normal auto-deploy. Create a fine-grained Personal Access
# Token at github.com/settings/personal-access-tokens scoped to just this
# repo, with "Contents: Read and write" permission, and paste it below.
GITHUB_TOKEN=github_pat_replace-with-a-fine-grained-token

# --- Admin login ---
# Generate the password hash with: node scripts/hash-password.mjs "your-password"
# Note the escaped \$ signs below -- Next.js expands unescaped $VAR references in .env
# files, which would corrupt a bcrypt hash. Use the raw (unescaped) hash in Vercel instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2b\$12\$replace-with-generated-hash

# --- Session signing secret ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string
